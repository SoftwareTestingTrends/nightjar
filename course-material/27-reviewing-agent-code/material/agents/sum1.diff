+    @app.get("/api/summary")
+    def api_summary():
+        now = clock()
+        all_nights = diary.nights()
+        # Compare instants (UTC), so the 7-day window is exact across DST.
+        recent = [n for n in all_nights if now - timedelta(days=7) <= n.bedtime <= now]
+        average = sum((n.duration for n in recent), timedelta()) / len(recent) if recent else None
+        bedtime = usual_bedtime(all_nights)
+        return {
+            "timezone": diary.user().timezone,
+            "nights_logged": len(recent),
+            "average_sleep_minutes": round(average.total_seconds() / 60) if average else None,
+            "usual_bedtime": f"{bedtime:%H:%M}" if bedtime else None,
+        }
