from datetime import datetime
from zoneinfo import ZoneInfo

import pytest
from builders import LONDON, TORONTO, night

from nightjar.models import Night
from nightjar.summary import weekly_summary

NOW = datetime(2026, 3, 20, 12, 0, tzinfo=ZoneInfo(TORONTO))


def test_T_201_1_counts_and_averages_last_7_days():
    nights = [
        night("2026-03-19", "23:00", hours=8),
        night("2026-03-18", "23:00", hours=7),
        night("2026-03-10", "23:00", hours=4),  # too old
    ]
    summary = weekly_summary(nights, NOW)
    assert summary.nights_logged == 2
    assert summary.average_sleep_minutes == 450


def test_T_201_2_no_nights_means_no_average():
    summary = weekly_summary([night("2026-03-01", "23:00")], NOW)
    assert (summary.nights_logged, summary.average_sleep_minutes) == (0, None)


def test_T_201_3_window_edge_is_exclusive_and_future_nights_ignored():
    wakes_exactly_7_days_ago = night("2026-03-12", "04:00", hours=8)  # wakes 03-13 12:00
    not_yet_woken = night("2026-03-20", "23:00")
    assert weekly_summary([wakes_exactly_7_days_ago, not_yet_woken], NOW).nights_logged == 0


def test_T_201_4_dst_night_uses_real_duration():
    # Toronto springs forward on 2026-03-08: 23:00 -> 07:00 is 7 real hours.
    start = datetime(2026, 3, 7, 23, 0, tzinfo=ZoneInfo(TORONTO))
    wake = datetime(2026, 3, 8, 7, 0, tzinfo=ZoneInfo(TORONTO))
    now = datetime(2026, 3, 9, 12, 0, tzinfo=ZoneInfo(LONDON))
    stay = Night(bedtime=start, wake_time=wake, timezone=TORONTO)
    assert weekly_summary([stay], now).average_sleep_minutes == 420


def test_T_201_5_naive_now_rejected():
    with pytest.raises(ValueError):
        weekly_summary([], datetime(2026, 3, 20, 12, 0))
