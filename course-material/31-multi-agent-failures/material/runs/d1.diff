"""Weekly summary: how many nights were logged in the last 7 days, and the average sleep."""

from dataclasses import dataclass
from datetime import UTC, datetime, timedelta

from nightjar.models import Night

WINDOW = timedelta(days=7)


@dataclass(frozen=True)
class WeeklySummary:
    nights_logged: int
    average_sleep_minutes: int | None  # None when no nights were logged


def weekly_summary(nights: list[Night], now: datetime) -> WeeklySummary:
    """Nights whose wake time falls in the 7 x 24 hours up to `now`.

    Compared as UTC instants, so DST and the user's zone don't shift the window.
    """
    if now.tzinfo is None:
        raise ValueError("now must be timezone-aware")
    end = now.astimezone(UTC)
    start = end - WINDOW
    recent = [n for n in nights if start < n.wake_time.astimezone(UTC) <= end]
    if not recent:
        return WeeklySummary(0, None)
    total = sum((n.duration for n in recent), timedelta())
    return WeeklySummary(len(recent), round(total / len(recent) / timedelta(minutes=1)))
