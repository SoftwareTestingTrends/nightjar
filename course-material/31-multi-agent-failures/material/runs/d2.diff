"""Weekly summary: how many nights were logged in the last 7 days, and the average sleep."""

from collections.abc import Sequence
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta

from nightjar.models import Night

WINDOW = timedelta(days=7)


@dataclass(frozen=True)
class WeeklySummary:
    nights_logged: int
    average_sleep_hours: float | None  # None when no nights were logged


def weekly_summary(nights: Sequence[Night], now: datetime) -> WeeklySummary:
    """Nights whose wake time falls in the 7 days up to `now` (compared as UTC instants)."""
    if now.tzinfo is None:
        raise ValueError("now must be timezone-aware")
    end = now.astimezone(UTC)
    start = end - WINDOW
    recent = [n for n in nights if start < n.wake_time.astimezone(UTC) <= end]
    if not recent:
        return WeeklySummary(nights_logged=0, average_sleep_hours=None)
    total = sum((n.duration for n in recent), timedelta())
    return WeeklySummary(len(recent), round(total.total_seconds() / len(recent) / 3600, 2))
