"""Weekly summary: nights in the last 7 days and their average sleep."""

from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

import pytest
from builders import TORONTO, night

from nightjar.models import Night
from nightjar.summary import weekly_summary

NOW = datetime(2026, 3, 20, 12, 0, tzinfo=ZoneInfo(TORONTO))


def test_no_nights_gives_zero_and_no_average():
    summary = weekly_summary([], NOW)
    assert summary.nights_logged == 0
    assert summary.average_sleep_hours is None


def test_counts_and_averages_only_the_last_7_days():
    nights = [
        night("2026-03-19", "23:00", hours=8),
        night("2026-03-18", "23:00", hours=6),
        night("2026-03-10", "23:00", hours=4),  # too old
    ]
    summary = weekly_summary(nights, NOW)
    assert summary.nights_logged == 2
    assert summary.average_sleep_hours == 7.0


def test_window_edges():
    inside = night("2026-03-13", "23:00", hours=8)  # wakes 07:00 on the 14th: inside
    on_edge = night("2026-03-12", "23:00", hours=13)  # wakes exactly NOW - 7 days: excluded
    assert on_edge.wake_time == NOW - timedelta(days=7)
    future = night("2026-03-20", "23:00")  # wakes after NOW
    assert weekly_summary([inside, on_edge, future], NOW).nights_logged == 1


def test_duration_is_correct_across_dst():
    # Toronto springs forward on 2026-03-08: 23:00 to 07:00 wall-clock is 7 real hours.
    toronto = ZoneInfo(TORONTO)
    dst_night = Night(
        bedtime=datetime(2026, 3, 7, 23, 0, tzinfo=toronto),
        wake_time=datetime(2026, 3, 8, 7, 0, tzinfo=toronto),
        timezone=TORONTO,
    )
    now = datetime(2026, 3, 9, 12, 0, tzinfo=ZoneInfo(TORONTO))
    assert weekly_summary([dst_night], now).average_sleep_hours == 7.0


def test_naive_now_is_rejected():
    with pytest.raises(ValueError):
        weekly_summary([], datetime(2026, 3, 20, 12, 0))
