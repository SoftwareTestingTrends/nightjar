diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..5f2dcd1
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,53 @@
+"""Journal search: API and home page, using the real app with a temp database."""
+
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+import pytest
+from fastapi.testclient import TestClient
+
+from nightjar.coach import MockCoach
+from nightjar.diary import Diary
+from nightjar.web import create_app
+
+NOON_IN_TORONTO = datetime(2026, 3, 20, 12, 0, tzinfo=ZoneInfo("America/Toronto"))
+
+
+@pytest.fixture
+def client(tmp_path):
+    app = create_app(
+        diary=Diary(tmp_path / "test.db"),
+        coach=MockCoach(),
+        clock=lambda: NOON_IN_TORONTO,
+        trace_path=tmp_path / "coach.jsonl",
+    )
+    return TestClient(app)
+
+
+def add_note(client, bedtime, wake, notes):
+    return client.post(
+        "/nights",
+        data={
+            "bedtime": bedtime,
+            "wake_time": wake,
+            "timezone": "America/Toronto",
+            "notes": notes,
+        },
+    )
+
+
+def test_search_finds_notes_and_tolerates_typos(client):
+    add_note(client, "2026-03-01T23:00", "2026-03-02T07:00", "Had coffee late, slept badly")
+    add_note(client, "2026-03-02T23:00", "2026-03-03T07:00", "Read a book, slept well")
+    body = client.get("/api/search", params={"q": "cofee"}).json()
+    assert [n["notes"] for n in body["nights"]] == ["Had coffee late, slept badly"]
+    assert client.get("/api/search", params={"q": "zebra"}).json()["nights"] == []
+    assert client.get("/api/search").json()["nights"] == []
+
+
+def test_search_page_shows_escaped_query_above_results(client):
+    add_note(client, "2026-03-01T23:00", "2026-03-02T07:00", "Had coffee late")
+    page = client.get("/", params={"q": "<b>cofee"})
+    assert "&lt;b&gt;cofee" in page.text
+    assert "<b>cofee" not in page.text
+    assert 'data-testid="search-result"' in client.get("/", params={"q": "coffe"}).text
