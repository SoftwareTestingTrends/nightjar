+"""Journal search: every query word must match a word in the note, allowing small typos."""
+
+import re
+from difflib import SequenceMatcher
+
+from nightjar.models import Night
+
+MIN_SIMILARITY = 0.8  # "cofee" ~ "coffee" (0.91); "tea" !~ "ten" (0.67)
+MAX_QUERY_LENGTH = 200
+
+
+def _words(text: str) -> list[str]:
+    return re.findall(r"\w+", text.casefold())
+
+
+def _word_matches(query_word: str, note_words: list[str]) -> bool:
+    for word in note_words:
+        if query_word in word:
+            return True
+        if SequenceMatcher(None, query_word, word).ratio() >= MIN_SIMILARITY:
+            return True
+    return False
+
+
+def search_nights(nights: list[Night], query: str) -> list[Night]:
+    """Nights whose notes match every word of `query`, keeping the input order."""
+    query_words = _words(query[:MAX_QUERY_LENGTH])
+    if not query_words:
+        return []
+    results = []
+    for night in nights:
+        note_words = _words(night.notes)
+        if note_words and all(_word_matches(q, note_words) for q in query_words):
+            results.append(night)
+    return results
