+def test_search_is_logged_with_text_and_result_count(client, tmp_path):
+    add_note(client, "2026-03-10", "Had coffee late")
+    client.get("/search", params={"q": "coffee"})
+    client.get("/api/search", params={"q": "zzzz\nx"})
+    lines = (tmp_path / "search.log").read_text().splitlines()
+    records = [json.loads(line) for line in lines]
+    assert [(r["query"], r["results"]) for r in records] == [("coffee", 1), ("zzzz\nx", 0)]
