+def log_search(path: Path, now: datetime, query: str, result_count: int) -> None:
+    """Append one JSON line per search (JSON keeps odd characters in the query on one line)."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    record = {"timestamp": now.isoformat(), "query": query, "result_count": result_count}
+    with path.open("a", encoding="utf-8") as log_file:
+        log_file.write(json.dumps(record) + "\n")
+
