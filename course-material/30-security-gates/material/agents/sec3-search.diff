diff --git a/tests/test_api.py b/tests/test_api.py
index a5a4e02..14d5a55 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -117,3 +117,35 @@ def test_coach_json_api(client):
     response = client.post("/api/coach", json={"question": "I get chest pain at night"})
     assert response.status_code == 200
     assert "seek medical care" in response.json()["answer"]
+
+
+def add_note(client, day, notes):
+    return client.post(
+        "/nights",
+        data={
+            "bedtime": f"2026-03-{day:02d}T23:00",
+            "wake_time": f"2026-03-{day + 1:02d}T07:00",
+            "timezone": "America/Toronto",
+            "notes": notes,
+        },
+    )
+
+
+def search(client, q):
+    return client.get("/api/search", params={"q": q}).json()["nights"]
+
+
+def test_search_finds_notes_and_tolerates_typos(client):
+    add_note(client, 10, "Drank coffee late, restless")
+    add_note(client, 11, "Read a book, slept well")
+    assert [n["notes"] for n in search(client, "cofee")] == ["Drank coffee late, restless"]
+    assert search(client, "zebra") == []
+    assert search(client, "") == []
+
+
+def test_search_page_shows_escaped_query_above_results(client):
+    add_note(client, 10, "Drank coffee late")
+    page = client.get("/", params={"q": "<b>coffee"})
+    assert "Results for: &lt;b&gt;coffee" in page.text
+    page = client.get("/", params={"q": "coffee"})
+    assert page.text.index("search-query") < page.text.index('data-testid="search-result"')
