 import re
+from datetime import datetime
 from difflib import SequenceMatcher
+from pathlib import Path
 
 from nightjar.models import Night
 
+DEFAULT_SEARCH_LOG_PATH = Path(os.environ.get("NIGHTJAR_SEARCH_LOG_PATH", "logs/search.log"))
 MIN_SIMILARITY = 0.8
 MIN_FUZZY_LENGTH = 4  # shorter words must match exactly (or as a prefix): "bad" is not "bed"
 
@@ -31,3 +36,11 @@ def note_matches(query: str, notes: str) -> bool:
 
 def search_nights(nights: list[Night], query: str) -> list[Night]:
     return [night for night in nights if note_matches(query, night.notes)]
+
+
+def log_search(path: Path, query: str, result_count: int, now: datetime) -> None:
+    """Append one JSON line per search (JSON keeps a query with newlines on one line)."""
+    record = {"at": now.isoformat(), "query": query, "results": result_count}
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("a", encoding="utf-8") as log_file:
+        log_file.write(json.dumps(record) + "\n")
