+    search(client, "cofee")
+    client.get("/", params={"q": "zebra"})
+    search(client, "")
+    lines = (tmp_path / "logs" / "search.log").read_text().splitlines()
+    records = [json.loads(line) for line in lines]
+    assert [(r["query"], r["results"]) for r in records] == [("cofee", 1), ("zebra", 0)]
