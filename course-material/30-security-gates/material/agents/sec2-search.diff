new file mode 100644
index 0000000..8c82994
--- /dev/null
+++ b/src/nightjar/search.py
@@ -0,0 +1,33 @@
+"""Journal search: every word of the query must match a word in the note, typos allowed."""
+
+import re
+from difflib import SequenceMatcher
+
+from nightjar.models import Night
+
+MIN_SIMILARITY = 0.8  # "cofee" ~ "coffee" is 0.91; "tea" vs "ten" is 0.67
+MIN_FUZZY_LENGTH = 4  # short words must match exactly, or "bed" would match "red"
+
+
+def _words(text: str) -> list[str]:
+    return re.findall(r"\w+", text.casefold())
+
+
+def _word_matches(query_word: str, note_word: str) -> bool:
+    if query_word in note_word:
+        return True
+    if len(query_word) < MIN_FUZZY_LENGTH:
+        return False
+    return SequenceMatcher(None, query_word, note_word).ratio() >= MIN_SIMILARITY
+
+
+def matches(notes: str, query: str) -> bool:
+    query_words = _words(query)
+    note_words = _words(notes)
+    return bool(query_words) and all(
+        any(_word_matches(q, w) for w in note_words) for q in query_words
+    )
+
+
+def search_nights(nights: list[Night], query: str) -> list[Night]:
+    return [night for night in nights if matches(night.notes, query)]
