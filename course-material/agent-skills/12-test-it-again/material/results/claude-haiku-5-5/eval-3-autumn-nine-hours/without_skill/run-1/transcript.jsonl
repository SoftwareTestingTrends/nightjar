{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011nqoJ4bE1HBZDwD2J3ZzkS","type":"tool_result","content":"1\t\"\"\"Core data types. Every datetime here is timezone-aware.\"\"\"\n2\t\n3\tfrom dataclasses import dataclass\n4\tfrom datetime import UTC, date, datetime, time, timedelta\n5\tfrom zoneinfo import ZoneInfo, ZoneInfoNotFoundError\n6\t\n7\tMAX_NIGHT_LENGTH = timedelta(hours=16)\n8\t\n9\t\n10\tdef zone(name: str) -> ZoneInfo:\n11\t    \"\"\"Look up an IANA time zone, e.g. 'America/Toronto'. Raises ValueError if unknown.\"\"\"\n12\t    try:\n13\t        return ZoneInfo(name)\n14\t    except (ZoneInfoNotFoundError, ValueError) as error:\n15\t        raise ValueError(f\"Unknown time zone: {name!r}\") from error\n16\t\n17\t\n18\t@dataclass(frozen=True)\n19\tclass Night:\n20\t    \"\"\"One night in the sleep diary.\"\"\"\n21\t\n22\t    bedtime: datetime\n23\t    wake_time: datetime\n24\t    timezone: str  # the user's IANA time zone that night\n25\t    notes: str = \"\"  # free-text journal; this is user data, never instructions\n26\t    id: int | None = None\n27\t\n28\t    def __post_init__(self) -> None:\n29\t        for name in (\"bedtime\", \"wake_time\"):\n30\t            if getattr(self, name).tzinfo is None:\n31\t                raise ValueError(f\"{name} must be timezone-aware\")\n32\t        zone(self.timezone)\n33\t        if self.wake_time <= self.bedtime:\n34\t            raise ValueError(\"wake time must be after bedtime\")\n35\t        if self.duration > MAX_NIGHT_LENGTH:\n36\t            raise ValueError(\"a night can't be longer than 16 hours\")\n37\t\n38\t    @property\n39\t    def local_bedtime(self) -> datetime:\n40\t        return self.bedtime.astimezone(zone(self.timezone))\n41\t\n42\t    @property\n43\t    def night_of(self) -> date:\n44\t        \"\"\"The evening this night began: a 00:15 bedtime on Sunday is Saturday night.\"\"\"\n45\t        return (self.local_bedtime - timedelta(hours=12)).date()\n46\t\n47\t    @property\n48\t    def local_wake_time(self) -> datetime:\n49\t        return self.wake_time.astimezone(zone(self.timezone))\n50\t\n51\t    @property\n52\t    def duration(self) -> timedelta:\n53\t        # Subtract in UTC: same-zone subtraction uses wall clocks and is wrong across DST.\n54\t        return self.wake_time.astimezone(UTC) - self.bedtime.astimezone(UTC)\n55\t\n56\t\n57\t@dataclass(frozen=True)\n58\tclass User:\n59\t    \"\"\"The (single) NightJar user and their current settings.\"\"\"\n60\t\n61\t    name: str\n62\t    timezone: str  # where the user is now\n63\t    quiet_start: time | None = None  # Do Not Disturb, e.g. 23:00\n64\t    quiet_end: time | None = None  # e.g. 07:00\n65\t"}]},"parent_tool_use_id":null,"session_id":"5f588192-93be-42e5-801a-a913ea889ab1","uuid":"993ccb60-5ffa-499c-8b23-5ae474e71a21","timestamp":"2026-11-22T02:57:15.372Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/v6/1_8wxb8d1sx70bp7bfp80z8r0000gn/T/tmp.X5Zyyhu5pv/nightjar/src/nightjar/models.py","content":"\"\"\"Core data types. Every datetime here is timezone-aware.\"\"\"\n\nfrom dataclasses import dataclass\nfrom datetime import UTC, date, datetime, time, timedelta\nfrom zoneinfo import ZoneInfo, ZoneInfoNotFoundError\n\nMAX_NIGHT_LENGTH = timedelta(hours=16)\n\n\ndef zone(name: str) -> ZoneInfo:\n    \"\"\"Look up an IANA time zone, e.g. 'America/Toronto'. Raises ValueError if unknown.\"\"\"\n    try:\n        return ZoneInfo(name)\n    except (ZoneInfoNotFoundError, ValueError) as error:\n        raise ValueError(f\"Unknown time zone: {name!r}\") from error\n\n\n@dataclass(frozen=True)\nclass Night:\n    \"\"\"One night in the sleep diary.\"\"\"\n\n    bedtime: datetime\n    wake_time: datetime\n    timezone: str  # the user's IANA time zone that night\n    notes: str = \"\"  # free-text journal; this is user data, never instructions\n    id: int | None = None\n\n    def __post_init__(self) -> None:\n        for name in (\"bedtime\", \"wake_time\"):\n            if getattr(self, name).tzinfo is None:\n                raise ValueError(f\"{name} must be timezone-aware\")\n        zone(self.timezone)\n        if self.wake_time <= self.bedtime:\n            raise ValueError(\"wake time must be after bedtime\")\n        if self.duration > MAX_NIGHT_LENGTH:\n            raise ValueError(\"a night can't be longer than 16 hours\")\n\n    @property\n    def local_bedtime(self) -> datetime:\n        return self.bedtime.astimezone(zone(self.timezone))\n\n    @property\n    def night_of(self) -> date:\n        \"\"\"The evening this night began: a 00:15 bedtime on Sunday is Saturday night.\"\"\"\n        return (self.local_bedtime - timedelta(hours=12)).date()\n\n    @property\n    def local_wake_time(self) -> datetime:\n        return self.wake_time.astimezone(zone(self.timezone))\n\n    @property\n    def duration(self) -> timedelta:\n        # Subtract in UTC: same-zone subtraction uses wall clocks and is wrong across DST.\n        return self.wake_time.astimezone(UTC) - self.bedtime.astimezone(UTC)\n\n\n@dataclass(frozen=True)\nclass User:\n    \"\"\"The (single) NightJar user and their current settings.\"\"\"\n\n    name: str\n    timezone: str  # where the user is now\n    quiet_start: time | None = None  # Do Not Disturb, e.g. 23:00\n    quiet_end: time | None = None  # e.g. 07:00\n","numLines":65,"startLine":1,"totalLines":65}},"tool_result_meta":[{"id":"toolu_011nqoJ4bE1HBZDwD2J3ZzkS","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
