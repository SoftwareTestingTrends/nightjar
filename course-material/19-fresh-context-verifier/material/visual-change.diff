diff --git a/src/nightjar/static/style.css b/src/nightjar/static/style.css
index 01f981b..3beeffb 100644
--- a/src/nightjar/static/style.css
+++ b/src/nightjar/static/style.css
@@ -30,6 +30,17 @@ h2:not(:first-child) { margin-top: 28px; }
   margin: 20px 0;
 }
 .nudge .big { font-size: 30px; margin: 0 0 8px; }
+.pill {
+  display: inline-block;
+  margin-left: 10px;
+  padding: 3px 14px;
+  border: 1px solid var(--moon);
+  border-radius: 999px;
+  color: var(--moon);
+  font-size: 18px;
+  line-height: 1.5;
+  vertical-align: middle;
+}
 .nudge strong { color: var(--moon); }
 .panel > :last-child { margin-bottom: 0; }
 .columns { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
